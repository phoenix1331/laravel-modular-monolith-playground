includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - modules/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Remove once the first tenant-owned model uses the trait; PHPStan flags unmatched ignores
        - identifier: trait.unused
          path: app/Tenancy/BelongsToOrganisation.php
