includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - modules/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    excludePaths:
        # Pest test files inside modules are checked by the test run, not PHPStan
        - modules/*/Tests/*

    level: 7
