@baseUrl = http://localhost:8000

# Web routes are protected by CSRF. Before any POST:
#   1. Run "Fetch the login page" below. Laravel sets an XSRF-TOKEN cookie.
#   2. Copy that cookie's value, URL-decoded (%3D becomes =), into @xsrf.
# Both VS Code REST Client and JetBrains HTTP Client keep the session cookie
# between requests, so later requests run as the signed-in user.
@xsrf = paste-xsrf-token-here

### Authentication

# Fetch the login page. Sets the XSRF-TOKEN and session cookies.
GET {{baseUrl}}/login
Accept: text/html

###

# Log in as a club admin. Redirects to /dashboard.
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "email": "test@example.com",
    "password": "password"
}

###

# Log out. Ends the session.
POST {{baseUrl}}/logout
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

### Role areas

# Club dashboard. 200 for admins and workers, 403 for the super admin, redirect to /login for guests.
GET {{baseUrl}}/dashboard
Accept: text/html

###

# Platform dashboard. 200 for the super admin only, 403 for club users.
GET {{baseUrl}}/platform
Accept: text/html

###

# Registration is disabled: users are created by club admins, so this returns 404.
GET {{baseUrl}}/register
Accept: text/html

### Teams

# List teams. Admins see every team in their club, workers only the teams they coach.
GET {{baseUrl}}/teams
Accept: text/html

###

# Create a team (admins only). worker_ids must be workers in the same club.
POST {{baseUrl}}/teams
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "name": "U12 Lions",
    "age_group": "U12",
    "worker_ids": []
}

###

# Show a team with its players and coaches. Another club's team id returns 404.
GET {{baseUrl}}/teams/1
Accept: text/html

###

# Update a team (admins only). Replaces the assigned coaches.
PUT {{baseUrl}}/teams/1
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "name": "U12 Lionesses",
    "age_group": "U12",
    "worker_ids": []
}

###

# Delete a team and its players (admins only).
DELETE {{baseUrl}}/teams/1
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

### Players

# Add a player to a team (admins only). Players are records, not logins.
POST {{baseUrl}}/teams/1/players
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "first_name": "Sam",
    "last_name": "Jones",
    "date_of_birth": "2014-05-01",
    "shirt_number": 7
}

###

# Update a player (admins only).
PUT {{baseUrl}}/players/1
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "first_name": "Sam",
    "last_name": "Jones",
    "shirt_number": 9
}

###

# Remove a player (admins only).
DELETE {{baseUrl}}/players/1
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

### Audit log

# Club audit trail (admins only). Changes to teams, players and users are recorded automatically by the AuditObserver.
GET {{baseUrl}}/audit
Accept: text/html

###

# Platform audit trail across every club (super admin only).
GET {{baseUrl}}/platform/audit
Accept: text/html

### Platform (super admin)

# Every organisation with user, team and enabled module counts.
GET {{baseUrl}}/platform
Accept: text/html

###

# One organisation's installed modules, with dependency state and blocked reasons.
GET {{baseUrl}}/platform/organisations/1
Accept: text/html

###

# Enable a module for a club. Fails with a "module" error if a hard dependency is off.
PUT {{baseUrl}}/platform/organisations/1/modules/fixtures
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "enabled": true
}

###

# Disable a module for a club. Fails while an enabled module hard-depends on it. Data is kept.
PUT {{baseUrl}}/platform/organisations/1/modules/fixtures
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "enabled": false
}

### Fixtures module (404 unless enabled for the signed-in user's club)

# Upcoming and recent fixtures for the teams the user can see.
GET {{baseUrl}}/fixtures
Accept: text/html

###

# Schedule a fixture (admins, or coaches for a team they coach). Fires the public FixtureScheduled event.
POST {{baseUrl}}/fixtures
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "team_id": 1,
    "venue_id": null,
    "opponent": "Harbour Town",
    "kick_off_at": "2026-10-10 10:30",
    "is_home": true,
    "competition": "League"
}

###

# Update a fixture. The team cannot be changed (team_id is prohibited here).
PUT {{baseUrl}}/fixtures/1
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "opponent": "Harbour Town Reserves",
    "kick_off_at": "2026-10-10 11:00",
    "is_home": false
}

###

# Remove a fixture.
DELETE {{baseUrl}}/fixtures/1
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

###

# Add a venue (admins only).
POST {{baseUrl}}/fixtures/venues
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "name": "Riverside Park",
    "address": "1 River Lane",
    "postcode": "RV1 2AB"
}

### Availability module (needs Fixtures; 404 unless both are enabled)

# Upcoming fixtures for the user's teams with available / maybe / unavailable counts.
GET {{baseUrl}}/availability
Accept: text/html

###

# One fixture's squad with each player's answer. Another club's fixture id is a 404.
GET {{baseUrl}}/availability/fixtures/1
Accept: text/html

###

# Record a player's answer (admins, or coaches of the fixture's team). status: available | maybe | unavailable.
PUT {{baseUrl}}/availability/fixtures/1/players/1
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "status": "unavailable",
    "note": "On holiday"
}

### Match Reports module (needs Fixtures; 404 unless both are enabled)

# Played fixtures for the user's teams, newest first, with the score once a report is filed.
GET {{baseUrl}}/match-reports
Accept: text/html

###

# One fixture's report form (or read-only view) with the squad.
GET {{baseUrl}}/match-reports/fixtures/1
Accept: text/html

###

# File or correct a report (admins, or coaches of the team, after kick-off). Players left out lose their row.
PUT {{baseUrl}}/match-reports/fixtures/1
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "goals_for": 3,
    "goals_against": 1,
    "summary": "Strong second half.",
    "performances": [
        { "player_id": 1, "goals": 2, "rating": 8 },
        { "player_id": 2, "goals": 1, "rating": 7 }
    ]
}

### Subscriptions module (admins only; 404 unless enabled)

# Fees with totals. status: due (default) | overdue | paid | all
GET {{baseUrl}}/subscriptions?status=overdue
Accept: text/html

###

# Charge every player in a team. amount is in pounds and stored in pence.
POST {{baseUrl}}/subscriptions/fees
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

{
    "team_id": 1,
    "description": "2026/27 season subs",
    "amount": "120.00",
    "due_on": "2026-11-01"
}

###

# Take a payment through the fake gateway. A declined charge returns a "payment" error.
POST {{baseUrl}}/subscriptions/fees/1/pay
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}

###

# Remove an unpaid fee.
DELETE {{baseUrl}}/subscriptions/fees/2
Accept: application/json
X-XSRF-TOKEN: {{xsrf}}
